{
  "name": "littlebread-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx scripts/site.ts dev",
    "build": "tsx scripts/site.ts build",
    "start": "serve out",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build:sample",
    "content:validate-obsidian": "tsx scripts/validate-obsidian.ts",
    "content:render-obsidian": "tsx scripts/render-obsidian.ts",
    "build:sample": "tsx scripts/site.ts sample",
    "content:prepare": "tsx scripts/site.ts prepare"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "serve": "^14.2.6",
    "tsx": "^4.23.12",
    "typescript": "~6.0.0",
    "vitest": "^4.1.10"
  }
}
