---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const hobbyPosts = await getCollection('hobby');
	return hobbyPosts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}

const post = Astro.props;
const { Content } = await post.render();
---

<Layout
	title={post.data.title}
	description={post.data.description}
	pubDate={post.data.pubDate}
	heroImage={post.data.heroImage}
>
	<article class="hobby-post">
		<header class="post-header">
			<div class="post-meta">
				<time datetime={post.data.pubDate.toISOString()}>
					{post.data.pubDate.toLocaleDateString('ko-KR')}
				</time>
				{post.data.category && (
					<span class="category">{post.data.category}</span>
				)}
			</div>
			<h1 class="post-title">{post.data.title}</h1>
			<p class="post-description">{post.data.description}</p>
		</header>

		<div class="post-content">
			<Content />
		</div>

		<footer class="post-footer">
			<div class="back-link">
				<a href="/hobby/">← 취미 블로그로 돌아가기</a>
			</div>
		</footer>
	</article>

	<style>
		.hobby-post {
			max-width: 800px;
			margin: 0 auto;
			padding: 2rem;
		}

		.post-header {
			margin-bottom: 2rem;
			padding-bottom: 1.5rem;
			border-bottom: 1px solid #e0e0e0;
		}

		.post-meta {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 1rem;
			font-size: 0.9rem;
			color: #666;
		}

		.category {
			background: #e3f2fd;
			color: #1976d2;
			padding: 0.25rem 0.75rem;
			border-radius: 20px;
			font-size: 0.8rem;
			font-weight: 500;
		}

		.post-title {
			font-size: 2.5rem;
			font-weight: bold;
			color: #333;
			margin-bottom: 1rem;
			line-height: 1.2;
		}

		.post-description {
			font-size: 1.1rem;
			color: #666;
			line-height: 1.6;
		}

		.post-content {
			font-size: 1.1rem;
			line-height: 1.8;
			color: #333;
		}

		.post-content h2 {
			font-size: 1.8rem;
			margin: 2rem 0 1rem 0;
			color: #444;
		}

		.post-content h3 {
			font-size: 1.4rem;
			margin: 1.5rem 0 0.75rem 0;
			color: #555;
		}

		.post-content p {
			margin-bottom: 1.5rem;
		}

		.post-content img {
			max-width: 100%;
			height: auto;
			border-radius: 8px;
			margin: 1.5rem 0;
		}

		.post-content blockquote {
			border-left: 4px solid #667eea;
			padding-left: 1.5rem;
			margin: 1.5rem 0;
			font-style: italic;
			color: #666;
		}

		.post-content code {
			background: #f5f5f5;
			padding: 0.2rem 0.4rem;
			border-radius: 4px;
			font-family: 'Courier New', monospace;
		}

		.post-content pre {
			background: #f5f5f5;
			padding: 1rem;
			border-radius: 8px;
			overflow-x: auto;
			margin: 1.5rem 0;
		}

		.post-footer {
			margin-top: 3rem;
			padding-top: 2rem;
			border-top: 1px solid #e0e0e0;
		}

		.back-link a {
			color: #667eea;
			text-decoration: none;
			font-weight: 500;
		}

		.back-link a:hover {
			text-decoration: underline;
		}

		@media (max-width: 768px) {
			.hobby-post {
				padding: 1rem;
			}

			.post-title {
				font-size: 2rem;
			}

			.post-meta {
				flex-direction: column;
				align-items: flex-start;
				gap: 0.5rem;
			}
		}
	</style>
</Layout>
